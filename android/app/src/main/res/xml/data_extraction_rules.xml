<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 o superior. Contigo no participa en la copia en la nube ni en la
  transferencia entre dispositivos: el journey guarda nombres de la red y
  respuestas por relación, que no deben salir del teléfono (auditoría 1, S1-H03).
  allowBackup="false" no basta en Android 12+, porque la transferencia directa
  entre dispositivos sigue activa salvo que estas reglas la excluyan.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
