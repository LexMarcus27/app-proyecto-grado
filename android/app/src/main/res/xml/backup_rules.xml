<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 o inferior. Refuerza allowBackup="false": si algún fabricante
  ignora ese atributo, la copia automática igual queda vacía (S1-H03).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
